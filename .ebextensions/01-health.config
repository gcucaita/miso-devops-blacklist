# Health check del Application Load Balancer.
# /health no requiere token, así el balanceador no recibe 401.
# La política de despliegue (AllAtOnce, Rolling, ...) NO se fija aquí:
# se cambia en la consola antes de cada despliegue para tomar las capturas,
# y un valor en .ebextensions la sobrescribiría.
option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    MatcherHTTPCode: 200
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
