# Crea las tablas en RDS al desplegar (db.create_all solo crea las que no
# existen: no duplica ni borra datos).
# leader_only: se ejecuta en UNA sola instancia por despliegue, para evitar que
# 3-6 instancias intenten crear la tabla al mismo tiempo.
# En Amazon Linux 2023 las Environment properties (DATABASE_URL, JWT_SECRET_KEY) no
# llegan solas a container_commands: se leen con get-config y se exportan.
# La salida queda en /var/log/init-db.log, que aparece en "Solicitar registros".
files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/init-db.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/init-db.log
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/init-db.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/init-db.log

container_commands:
  01_init_db:
    command: |
      eval "$(/opt/elasticbeanstalk/bin/get-config environment | /var/app/venv/*/bin/python -c 'import json,sys,shlex; [print(f"export {k}={shlex.quote(v)}") for k,v in json.load(sys.stdin).items()]')"
      echo "=== init-db $(date -u +%FT%TZ) ===" >> /var/log/init-db.log
      /var/app/venv/*/bin/python -m flask --app application:application init-db >> /var/log/init-db.log 2>&1
      rc=$?
      echo "exit=$rc" >> /var/log/init-db.log
      tail -n 40 /var/log/init-db.log
      exit $rc
    leader_only: true
