# Crea las tablas en RDS al desplegar (db.create_all solo crea las que no
# existen: no duplica ni borra datos).
# leader_only: se ejecuta en UNA sola instancia por despliegue, para evitar que
# 3-6 instancias intenten crear la tabla al mismo tiempo.
# En Amazon Linux 2023 las Environment properties (DATABASE_URL, API_TOKEN) no
# llegan solas a container_commands: se leen con get-config y se exportan.
container_commands:
  01_init_db:
    command: |
      eval "$(/opt/elasticbeanstalk/bin/get-config environment | /var/app/venv/*/bin/python -c 'import json,sys,shlex; [print(f"export {k}={shlex.quote(v)}") for k,v in json.load(sys.stdin).items()]')"
      /var/app/venv/*/bin/python -m flask --app application:application init-db
    leader_only: true
