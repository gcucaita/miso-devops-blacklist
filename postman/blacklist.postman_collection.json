      "name": "POST /blacklists",
      "item": [
        {
          "name": "01 · POST /blacklists (201 creado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Crea un email único. Se envía en MAYÚSCULAS y con espacios: la API debe guardarlo en minúsculas y sin espacios.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_bloqueado_raw}}\",\n  \"app_uuid\": \"{{app_uuid}}\",\n  \"blocked_reason\": \"Fraude reportado por QA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email único por corrida; se envía con mayúsculas/espacios para probar la normalización",
                  "const email = `qa.blacklist.${Date.now()}@ejemplo.com`;",
                  "pm.environment.set(\"email_bloqueado\", email);",
                  "pm.environment.set(\"email_bloqueado_raw\", `  ${email.toUpperCase()}  `);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Mensaje de éxito\", () => pm.expect(b.message).to.eql(\"Correo agregado correctamente.\"));",
                  "pm.test(\"Devuelve el email guardado (normalizado)\", () => pm.expect(b.data.email).to.eql(pm.environment.get(\"email_bloqueado\")));",
                  "pm.test(\"Devuelve app_uuid\", () => pm.expect(b.data.app_uuid).to.eql(pm.environment.get(\"app_uuid\")));",
                  "pm.test(\"Devuelve blocked_reason\", () => pm.expect(b.data.blocked_reason).to.eql(\"Fraude reportado por QA\"));",
                  "pm.test(\"id numérico y created_at ISO\", () => { pm.expect(b.data.id).to.be.a(\"number\"); pm.expect(Date.parse(b.data.created_at)).to.not.be.NaN; });"
                ]
              }
            }
          ]
        },
